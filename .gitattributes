# Keep the checkout byte-identical on every platform.
#
# Without this, Git on Windows checks source files out with CRLF, which changes
# the bytes of files an implementation may hash and breaks the line-ending rule
# the linter enforces. This is the same reasoning as the `-text` attribute that
# `fridge init` writes for `.fridge/notes/**`.
* text=auto eol=lf

# PowerShell is the one exception. Some hosts and older parsers are unhappy with
# LF-only .ps1 files, so these keep CRLF, and the linter exempts them.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Generated, and reviewed as a whole rather than line by line.
spec/exit-codes.md linguist-generated=true
