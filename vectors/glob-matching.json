{
  "protocol": "wcp/0.1",
  "title": "Glob subset conformance vectors",
  "note": "The supported subset is deliberately small: * ? ** [class] {a,b}. Anything else must be rejected, not approximated.",
  "cases": [
    { "name": "star does not cross a slash", "pattern": "src/*.ts",
      "matches": ["src/a.ts", "src/index.ts"],
      "rejects": ["src/api/a.ts", "a.ts", "src/a.tsx"] },
    { "name": "globstar crosses slashes", "pattern": "src/**",
      "matches": ["src/a.ts", "src/api/a.ts", "src/api/deep/b.ts"],
      "rejects": ["docs/a.ts", "srcx/a.ts"] },
    { "name": "globstar in the middle", "pattern": "src/**/*.ts",
      "matches": ["src/a.ts", "src/api/a.ts", "src/api/deep/b.ts"],
      "rejects": ["src/api/a.js", "docs/a.ts"] },
    { "name": "question mark is exactly one character", "pattern": "src/db?.ts",
      "matches": ["src/db1.ts", "src/dbx.ts"],
      "rejects": ["src/db.ts", "src/db12.ts", "src/db/x.ts"] },
    { "name": "character class", "pattern": "src/[abc].ts",
      "matches": ["src/a.ts", "src/b.ts"],
      "rejects": ["src/d.ts", "src/ab.ts"] },
    { "name": "negated character class", "pattern": "src/[!abc].ts",
      "matches": ["src/d.ts", "src/z.ts"],
      "rejects": ["src/a.ts", "src/c.ts"] },
    { "name": "character range", "pattern": "src/[a-c].ts",
      "matches": ["src/a.ts", "src/c.ts"],
      "rejects": ["src/d.ts"] },
    { "name": "a literal path matches only itself", "pattern": "README.md",
      "matches": ["README.md"],
      "rejects": ["docs/README.md", "README.md.bak"] },
    { "name": "dots in the pattern are literal, not regex", "pattern": "src/a.ts",
      "matches": ["src/a.ts"],
      "rejects": ["src/axts"] },
    { "name": "regex metacharacters are literal", "pattern": "src/a+b.ts",
      "matches": ["src/a+b.ts"],
      "rejects": ["src/aab.ts", "src/ab.ts"] }
  ]
}
