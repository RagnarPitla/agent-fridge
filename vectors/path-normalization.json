{
  "protocol": "wcp/0.1",
  "title": "Path normalization conformance vectors",
  "note": "root is the workspace root. cwd is relative to root. expect is the normalized pattern, or the string E_PATH_INVALID.",
  "fixture": {
    "note": "Materialize this tree in a throwaway directory and use it as root. Required because normalization resolves real paths.",
    "dirs": ["src/api", "src/ui", "docs"],
    "files": {
      "src/api/routes.ts": "export const routes = [];\n",
      "src/api/db.ts": "export const db = 1;\n",
      "src/ui/app.tsx": "export const App = () => null;\n",
      "docs/guide.md": "# guide\n",
      "README.md": "# demo\n"
    }
  },
  "cases": [
    { "name": "plain file", "input": "src/api/routes.ts", "expect": "src/api/routes.ts" },
    { "name": "leading ./ is stripped", "input": "./src/api/routes.ts", "expect": "src/api/routes.ts" },
    { "name": "duplicate slashes collapse", "input": "src//api///routes.ts", "expect": "src/api/routes.ts" },
    { "name": "trailing slash keeps the path but records directory intent", "input": "src/api/", "expect": "src/api" },
    { "name": "globstar survives", "input": "src/**", "expect": "src/**" },
    { "name": "single star survives", "input": "src/*.ts", "expect": "src/*.ts" },
    { "name": "question mark survives", "input": "src/api/db?.ts", "expect": "src/api/db?.ts" },
    { "name": "character class survives", "input": "src/api/[abc]*.ts", "expect": "src/api/[abc]*.ts" },
    { "name": "brace alternation survives normalization", "input": "src/{api,ui}/**", "expect": "src/{api,ui}/**" },
    { "name": "relative from a subdirectory", "input": "routes.ts", "cwd": "src/api", "expect": "src/api/routes.ts" },
    { "name": "dot-dot inside the workspace resolves", "input": "../ui/app.tsx", "cwd": "src/api", "expect": "src/ui/app.tsx" },
    { "name": "glob relative to a subdirectory", "input": "*.ts", "cwd": "src/api", "expect": "src/api/*.ts" },
    { "name": "absolute path inside the workspace is relativized", "input": "<ROOT>/src/api/routes.ts", "expect": "src/api/routes.ts" },
    { "name": "escaping the workspace is rejected", "input": "../outside.ts", "expect": "E_PATH_INVALID" },
    { "name": "deep escape is rejected", "input": "src/../../outside.ts", "expect": "E_PATH_INVALID" },
    { "name": "the .git directory is reserved", "input": ".git/config", "expect": "E_PATH_INVALID" },
    { "name": "the state directory is reserved", "input": ".fridge/claims", "expect": "E_PATH_INVALID" },
    { "name": "the state directory is reserved even as a glob", "input": ".fridge/**", "expect": "E_PATH_INVALID" },
    { "name": "home-relative paths are rejected rather than guessed", "input": "~/notes.md", "expect": "E_PATH_INVALID" },
    { "name": "UNC paths are rejected", "input": "//server/share/file.ts", "expect": "E_PATH_INVALID" },
    { "name": "NUL bytes are rejected", "input": "src/a\u0000b.ts", "expect": "E_PATH_INVALID" },
    { "name": "newlines are rejected", "input": "src/a\nb.ts", "expect": "E_PATH_INVALID" },
    { "name": "empty input is rejected", "input": "   ", "expect": "E_PATH_INVALID" },
    { "name": "the whole workspace needs an explicit flag", "input": ".", "expect": "E_PATH_INVALID" },
    { "name": "a colon in a segment is rejected (Windows ADS)", "input": "src/file.ts:stream", "expect": "E_PATH_INVALID" },
    { "name": "a reserved Windows device name is rejected", "input": "src/CON", "expect": "E_PATH_INVALID" },
    { "name": "a segment ending in a space is rejected", "input": "src/bad /file.ts", "expect": "E_PATH_INVALID" },
    { "name": "a segment ending in a dot is rejected", "input": "src/bad./file.ts", "expect": "E_PATH_INVALID" }
  ]
}
