{
  "name": "agent-fridge",
  "version": "0.2.2",
  "description": "The shared whiteboard for AI coding agents. Atomic path claims, leases, write-once notes and handoffs so several agents and humans work in one Git checkout without overwriting each other. Local-first, zero dependencies, model-neutral.",
  "keywords": [
    "ai-agents",
    "ai-coding-agents",
    "multi-agent",
    "coordination",
    "shared-whiteboard",
    "shared-checkout",
    "file-locking",
    "claude-code",
    "github-copilot",
    "codex",
    "tmux",
    "developer-tools",
    "local-first"
  ],
  "license": "Apache-2.0",
  "author": "Ragnar Pitla",
  "homepage": "https://ragnarpitla.github.io/agent-fridge/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RagnarPitla/agent-fridge.git"
  },
  "bugs": {
    "url": "https://github.com/RagnarPitla/agent-fridge/issues"
  },
  "type": "module",
  "bin": {
    "fridge": "bin/fridge.mjs",
    "agent-fridge": "bin/fridge.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "spec/",
    "skill/",
    "vectors/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {},
  "scripts": {
    "test": "node tools/run-tests.mjs test/unit test/integration",
    "test:unit": "node tools/run-tests.mjs test/unit",
    "test:integration": "node tools/run-tests.mjs test/integration",
    "test:concurrency": "node tools/run-tests.mjs test/concurrency",
    "test:all": "node tools/run-tests.mjs test/unit test/integration test/concurrency",
    "site:check": "node tools/check-site.mjs",
    "gen": "node tools/gen-exit-codes.mjs",
    "gen:check": "node tools/gen-exit-codes.mjs --check",
    "demo": "node tools/demo.mjs",
    "lint": "node tools/lint.mjs",
    "check": "node tools/check.mjs",
    "check:fast": "node tools/check.mjs --fast",
    "go:build": "node tools/go.mjs build ./...",
    "go:vet": "node tools/go.mjs vet ./...",
    "go:test": "node tools/go.mjs test ./...",
    "go:parity": "node tools/parity.mjs",
    "go:fmt": "node tools/go.mjs fmt",
    "go:dist": "node tools/go.mjs dist",
    "parity": "node tools/parity.mjs",
    "conform": "node tools/go.mjs run ./cmd/fridge conform"
  }
}
